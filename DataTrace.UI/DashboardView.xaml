<UserControl x:Class="DataTrace.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Обзор безопасности" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

        <!-- Карточки статистики -->
        <UniformGrid Columns="3">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Всего процессов" FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalProcesses}" FontSize="36" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Всего инцидентов" FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalAlerts}" FontSize="36" FontWeight="Bold" Foreground="Orange"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Критических угроз" FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding CriticalAlerts}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource DangerColor}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Последние события -->
        <TextBlock Text="Последние инциденты" FontSize="20" FontWeight="SemiBold" Margin="10,30,0,10"/>
        <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowBackground="White" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DDD" MaxHeight="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="100"/>
                <DataGridTextColumn Header="Угроза" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>