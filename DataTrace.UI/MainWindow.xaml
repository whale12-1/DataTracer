<Window x:Class="DataTrace.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DataTrace.UI.Views"
        xmlns:conv="clr-namespace:DataTrace.UI.Converters"
        Title="DataTrace Security" Height="800" Width="1200" WindowStartupLocation="CenterScreen" Background="{StaticResource MainBackground}">

    <Window.Resources>
        <conv:EqualsConverter x:Key="EqualsConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- САЙДБАР -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="DataTrace" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,0,0,30"/>

                <RadioButton Content="📊 Дашборд" Style="{StaticResource NavButtonStyle}" 
                             IsChecked="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Dashboard, Mode=TwoWay}"/>
                <RadioButton Content="🚨 Инциденты" Style="{StaticResource NavButtonStyle}" 
                             IsChecked="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Alerts, Mode=TwoWay}"/>
                <RadioButton Content="🌐 Процессы" Style="{StaticResource NavButtonStyle}" 
                             IsChecked="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Processes, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <!-- ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Обновить" Width="120" Height="30" Click="RefreshButton_Click" Background="{StaticResource AccentColor}" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" VerticalContentAlignment="Center" Padding="5,0" Tag="Поиск по инцидентам..."/>
                </StackPanel>
            </Border>

            <!-- Контейнер для динамических View -->
            <!-- Контейнер для динамических View -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <!-- Дашборд -->
                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <!-- ВАЖНО: Добавляем DataContext, чтобы контрол видел MainViewModel -->
                                        <DataTemplate>
                                            <local:DashboardView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <!-- Инциденты -->
                            <DataTrigger Binding="{Binding CurrentView}" Value="Alerts">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <local:AlertsView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <!-- Процессы -->
                            <DataTrigger Binding="{Binding CurrentView}" Value="Processes">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <local:ProcessesView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</Window>